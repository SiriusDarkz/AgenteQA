# Copia este archivo como app/.env y rellena la llave. app/.env está en .gitignore:
# no se sube al repositorio. (Mac/Linux: cp app/.env.example app/.env · Windows: copy app\.env.example app\.env)
#
# Solo hace falta para el agente real (python3 -m app). El modo demo (python3 -m app --demo) no usa ninguna.

# ── Obligatoria en modo real ──────────────────────────────────────────────────
# Llave de la API de Anthropic, creada en https://platform.claude.com (API keys). Empieza por sk-ant-.
ANTHROPIC_API_KEY=sk-ant-pega-aqui-tu-llave

# ── Opcionales (si no están, se usa el valor indicado) ───────────────────────
# Modelo con el que corre el agente. Si se omite, el que trae por defecto el Agent SDK.
QA_MODELO=claude-opus-5-5

# Aplicación bajo prueba para npx playwright test (si cambias qa/requisitos.md a otra tienda).
# QA_BASE_URL=https://www.saucedemo.com

# Puerto de la interfaz web (por defecto 8765).
# QA_PUERTO=8765

# Ver el navegador mientras corren las pruebas del paso 3 (por defecto invisible).
# QA_HEADED=1

# Tope de turnos del agente por paso del ciclo (por defecto 80) y por mensaje libre (por defecto 12).
# QA_MAX_TURNOS=80
# QA_MAX_TURNOS_CONVERSACION=12

# Tope de gasto por mensaje libre de la conversación, en USD (por defecto 1.0).
# QA_PRESUPUESTO_CONVERSACION_USD=1.0

# Velocidad del modo demo: 1 = ritmo normal, 0.2 = cinco veces más rápido.
# QA_DEMO_VELOCIDAD=1
